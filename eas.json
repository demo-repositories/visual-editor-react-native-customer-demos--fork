{
  "cli": {
    "version": ">= 16.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "corepack": {
      "pnpm": "10.11.1"
    },
    "development": {
      "developmentClient": true,
      "environment": "development",
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "simulator": true,
        "image": "sdk-53"
      }
    },
    "production": {
      "distribution": "internal",
      "environment": "production",
      "autoIncrement": true
    },
    "bootbarn-preview": {
      "extends": "preview",
      "channel": "bootbarn-preview",
      "env": {
        "EXPO_PUBLIC_SANITY_PROJECT_ID": "962j2cll",
        "EXPO_PUBLIC_SANITY_DATASET": "boot-barn-react-native",
        "EXPO_PUBLIC_SANITY_STUDIO_URL": "http://localhost:3333"
      }
    },
    "bootbarn-production": {
      "extends": "production",
      "channel": "bootbarn-production",
      "env": {
        "EXPO_PUBLIC_SANITY_PROJECT_ID": "962j2cll",
        "EXPO_PUBLIC_SANITY_DATASET": "boot-barn-react-native",
        "EXPO_PUBLIC_SANITY_STUDIO_URL": "http://localhost:3333"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
